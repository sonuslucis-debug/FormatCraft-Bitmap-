<Window x:Class="ImageConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FormatCraft [Bitmap]" Height="780" Width="980" MinHeight="640" MinWidth="860"
        WindowStartupLocation="CenterScreen" Icon="/Images/app.ico"
        FontFamily="{StaticResource BrandFont}" Background="White"
        AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Branded header band -->
        <Border Grid.Row="0" Background="{StaticResource NavyBrush}" Padding="18,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="AboutButton" Content="About" Padding="12,4" VerticalAlignment="Center" Click="About_Click" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FORMATCRAFT" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="[BITMAP]" Foreground="{StaticResource SoftTextBrush}" FontSize="20" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource SoftTextBrush}" FontSize="12" Margin="14,5,0,0" VerticalAlignment="Center">by <Hyperlink
                        NavigateUri="https://sonuslucis.com" RequestNavigate="Link_RequestNavigate"
                        Foreground="White" ToolTip="Visit sonuslucis.com">Sonus Lucis</Hyperlink></TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Drop zone -->
            <Grid Grid.Row="0" Height="124" Margin="0,0,0,10">
                <Rectangle x:Name="DropRect" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                           StrokeDashArray="4 3" RadiusX="6" RadiusY="6" Fill="{StaticResource TintBrush}" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Drop images or folders here" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="AddFilesButton" Content="Add files..." Click="AddFiles_Click" />
                        <Button x:Name="AddFolderButton" Content="Add folder..." Margin="8,0,0,0" Click="AddFolder_Click" />
                        <Button x:Name="ClearButton" Content="Clear list" Margin="8,0,0,0" Click="Clear_Click" />
                        <CheckBox x:Name="SubfoldersBox" Content="Include subfolders" IsChecked="True"
                                  Margin="18,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="SupportedText" FontSize="11" Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="760" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>

            <!-- Queue -->
            <DataGrid Grid.Row="1" x:Name="QueueGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                      CanUserDeleteRows="False" SelectionMode="Extended" PreviewKeyDown="QueueGrid_PreviewKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="280" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="64" />
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="88" />
                    <DataGridTemplateColumn Header="Status" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" Margin="2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                    <Setter Property="Foreground" Value="#B00020" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Skipped">
                                                    <Setter Property="Foreground" Value="Gray" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Options -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <WrapPanel>
                    <TextBlock Text="Convert to:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="FormatBox" Width="90" DisplayMemberPath="Name" Margin="0,0,22,0"
                              SelectionChanged="Format_SelectionChanged" />

                    <StackPanel x:Name="QualityPanel" Orientation="Horizontal" Margin="0,0,22,0">
                        <TextBlock Text="Quality:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider x:Name="QualitySlider" Width="170" Minimum="1" Maximum="100" Value="90"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="Quality_ValueChanged" />
                        <TextBlock x:Name="QualityValue" Text="90" Width="30" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="BackgroundPanel" Orientation="Horizontal" Margin="0,0,22,0">
                        <TextBlock Text="Transparent areas:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="BackgroundBox" Width="80" SelectedIndex="0">
                            <ComboBoxItem Content="White" Tag="#FFFFFF" />
                            <ComboBoxItem Content="Black" Tag="#000000" />
                            <ComboBoxItem Content="Grey" Tag="#808080" />
                        </ComboBox>
                    </StackPanel>

                    <CheckBox x:Name="StripBox" Content="Remove camera and location data (EXIF)" VerticalAlignment="Center" />
                </WrapPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Save to:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton Grid.Column="1" x:Name="SameFolderRadio" Content="Next to the originals" IsChecked="True"
                                 VerticalAlignment="Center" Margin="0,0,18,0" />
                    <RadioButton Grid.Column="2" x:Name="FolderRadio" Content="This folder:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="3" x:Name="OutputBox" Padding="2" VerticalContentAlignment="Center"
                             GotFocus="OutputBox_GotFocus" />
                    <Button Grid.Column="4" x:Name="BrowseButton" Content="Browse..." Margin="8,0,0,0" Click="Browse_Click" />
                </Grid>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="ConvertButton" Content="Convert" Style="{StaticResource PrimaryButton}" Padding="26,5" Click="Convert_Click" />
                <Button x:Name="CancelButton" Content="Cancel" Padding="14,5" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click" />
                <Button x:Name="OpenFolderButton" Content="Open output folder" Padding="14,5" Margin="8,0,0,0" IsEnabled="False" Click="OpenFolder_Click" />
            </StackPanel>

            <!-- Progress -->
            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                <ProgressBar x:Name="RunProgress" Height="14" Minimum="0" Maximum="100" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DoneText" Grid.Column="0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                    <TextBlock x:Name="ElapsedText" Grid.Column="1" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                    <TextBlock x:Name="SpeedText" Grid.Column="2" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                    <TextBlock x:Name="FailedText" Grid.Column="3" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                </Grid>
                <TextBlock x:Name="StatusText" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
