<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FormatCraftBitmap</AssemblyName>
    <RootNamespace>ImageConverter</RootNamespace>
    <Version>0.2.0</Version>
    <ApplicationIcon>Images\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Fonts\Montserrat-Regular.ttf" />
    <Resource Include="Fonts\Montserrat-Bold.ttf" />
    <Resource Include="Images\logo.png" />
    <Resource Include="Images\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Q8 = 8 bits per channel: the fastest build, ideal for WEBP/JPG/PNG/HEIC work -->
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.15.0" />
  </ItemGroup>

</Project>
